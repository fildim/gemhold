rules_version = '2';
// Online leaderboard: one document per signed-in player, readable by anyone,
// written only by its owner. Scores are reported by the game, so a determined
// player could fake them; the limits below just keep documents sane.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'total', 'stars', 'rw', 'rl', 'scores', 'ach', 'updated', 'unlocked', 'best', 'skills', 'skills_t', 'reset_t', 'stats', 'full'])
        && (!('full' in request.resource.data) || request.resource.data.full is bool)
        && (!('unlocked' in request.resource.data) || (request.resource.data.unlocked is int && request.resource.data.unlocked >= 1 && request.resource.data.unlocked <= 100))
        && (!('best' in request.resource.data) || (request.resource.data.best is map && request.resource.data.best.size() <= 150))
        && (!('skills' in request.resource.data) || (request.resource.data.skills is map && request.resource.data.skills.size() <= 100))
        && (!('skills_t' in request.resource.data) || (request.resource.data.skills_t is int && request.resource.data.skills_t >= 0))
        && (!('reset_t' in request.resource.data) || (request.resource.data.reset_t is int && request.resource.data.reset_t >= 0))
        && (!('stats' in request.resource.data) || (request.resource.data.stats is map && request.resource.data.stats.size() <= 300))
        && (!('rw' in request.resource.data) || (request.resource.data.rw is int && request.resource.data.rw >= 0 && request.resource.data.rw <= 100000))
        && (!('rl' in request.resource.data) || (request.resource.data.rl is int && request.resource.data.rl >= 0 && request.resource.data.rl <= 100000))
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 16
        && request.resource.data.total is int
        && request.resource.data.total >= 0 && request.resource.data.total <= 10000000
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0 && request.resource.data.stars <= 300
        && request.resource.data.scores is map && request.resource.data.scores.size() <= 150
        && request.resource.data.ach is list && request.resource.data.ach.size() <= 500
        && request.resource.data.updated == request.time;
    }
    // Feedback from the game's Info page: anyone may send a message, nobody can
    // read them back from the game (the owner reads them in the console).
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'version', 'platform', 'name', 'uid', 'created'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.platform is string && request.resource.data.platform.size() <= 20
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 16))
        && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && request.resource.data.created == request.time;
    }
    // Challenges: a race booked for a time between two players. Only they can see or
    // change it; the sender opens it, either may propose another time, only the one
    // who did not propose the current time may accept it, and only the sender adds
    // the race code.
    match /challenges/{id} {
      function player() {
        return request.auth != null
          && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      }
      allow read, delete: if player();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'from_name', 'to', 'to_name', 'level', 'night', 'at', 'by', 'state', 'created'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.by == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.from_name is string && request.resource.data.from_name.size() <= 16
        && request.resource.data.to_name is string && request.resource.data.to_name.size() <= 16
        && request.resource.data.level is string && request.resource.data.level.size() <= 32
        && request.resource.data.night is bool
        && request.resource.data.at is int
        && request.resource.data.state == 'sent'
        && request.resource.data.created == request.time;
      allow update: if player()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['at', 'by', 'state', 'code'])
        && request.resource.data.state in ['sent', 'accepted', 'declined', 'cancelled']
        && request.resource.data.at is int
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['at', 'by'])
          || (request.resource.data.by == request.auth.uid && request.resource.data.state == 'sent'))
        && (request.resource.data.state != 'accepted' || resource.data.state == 'accepted'
          || (resource.data.state == 'sent' && resource.data.by != request.auth.uid))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['code'])
          || (request.auth.uid == resource.data.from && request.resource.data.code is string && request.resource.data.code.size() == 5));
    }
    // Online races: the host opens one, a rival joins it once, then each racer
    // writes only their own progress (h for the host, g for the guest).
    match /races/{code} {
      function progress(p) {
        return p is map && p.keys().hasOnly(['wave', 'gems', 'kills', 'score', 'done', 'won', 'stopped', 'time', 'out'])
          && (!('out' in p) || (p.out is string && p.out.size() <= 4000));
      }
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.host;
      allow create: if request.auth != null && code.size() == 5
        && request.resource.data.keys().hasOnly(['host', 'host_name', 'level', 'night', 'state', 'created', 'h'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.host_name is string && request.resource.data.host_name.size() <= 16
        && request.resource.data.level is string && request.resource.data.level.size() <= 32
        && request.resource.data.state == 'open'
        && request.resource.data.created == request.time
        && progress(request.resource.data.h);
      allow update: if request.auth != null && (
        (resource.data.state == 'open' && request.auth.uid != resource.data.host
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'guest_name', 'state', 'g'])
          && request.resource.data.guest == request.auth.uid
          && request.resource.data.guest_name is string && request.resource.data.guest_name.size() <= 16
          && request.resource.data.state == 'on'
          && progress(request.resource.data.g))
        || (request.auth.uid == resource.data.host
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['h'])
          && progress(request.resource.data.h))
        || (request.auth.uid == resource.data.get('guest', '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['g'])
          && progress(request.resource.data.g)));
    }
  }
}
