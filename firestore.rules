rules_version = '2';
// Online leaderboard: one document per signed-in player, readable by anyone,
// written only by its owner. Scores are reported by the game, so a determined
// player could fake them; the limits below just keep documents sane.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'total', 'stars', 'rw', 'rl', 'scores', 'ach', 'updated'])
        && (!('rw' in request.resource.data) || (request.resource.data.rw is int && request.resource.data.rw >= 0 && request.resource.data.rw <= 100000))
        && (!('rl' in request.resource.data) || (request.resource.data.rl is int && request.resource.data.rl >= 0 && request.resource.data.rl <= 100000))
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 16
        && request.resource.data.total is int
        && request.resource.data.total >= 0 && request.resource.data.total <= 10000000
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0 && request.resource.data.stars <= 200
        && request.resource.data.scores is map && request.resource.data.scores.size() <= 100
        && request.resource.data.ach is list && request.resource.data.ach.size() <= 64
        && request.resource.data.updated == request.time;
    }
    // Online races: the host opens one, a rival joins it once, then each racer
    // writes only their own progress (h for the host, g for the guest).
    match /races/{code} {
      function progress(p) {
        return p is map && p.keys().hasOnly(['wave', 'gems', 'kills', 'score', 'done', 'won', 'stopped', 'time', 'out'])
          && (!('out' in p) || (p.out is string && p.out.size() <= 4000));
      }
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.host;
      allow create: if request.auth != null && code.size() == 5
        && request.resource.data.keys().hasOnly(['host', 'host_name', 'level', 'night', 'state', 'created', 'h'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.host_name is string && request.resource.data.host_name.size() <= 16
        && request.resource.data.level is string && request.resource.data.level.size() <= 32
        && request.resource.data.state == 'open'
        && request.resource.data.created == request.time
        && progress(request.resource.data.h);
      allow update: if request.auth != null && (
        (resource.data.state == 'open' && request.auth.uid != resource.data.host
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'guest_name', 'state', 'g'])
          && request.resource.data.guest == request.auth.uid
          && request.resource.data.guest_name is string && request.resource.data.guest_name.size() <= 16
          && request.resource.data.state == 'on'
          && progress(request.resource.data.g))
        || (request.auth.uid == resource.data.host
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['h'])
          && progress(request.resource.data.h))
        || (request.auth.uid == resource.data.get('guest', '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['g'])
          && progress(request.resource.data.g)));
    }
  }
}
